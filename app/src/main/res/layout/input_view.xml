<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_background"
    android:orientation="vertical"
    tools:ignore="Overdraw">

    <io.github.keyang556.kboard.candidates.CandidateBarView
        android:id="@+id/candidate_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- The candidate panel takes the place of the keys, at their size. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <io.github.keyang556.kboard.keyboard.KeyboardView
            android:id="@+id/keyboard_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <io.github.keyang556.kboard.candidates.CandidatePanelView
            android:id="@+id/candidate_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
